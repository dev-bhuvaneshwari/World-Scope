# ============================================
# WorldScope — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# The app runs in DEMO_MODE if API keys are missing

# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Leave empty to use in-memory MongoDB (development only)
MONGODB_URI=

# OpenAI — Required for AI summaries
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# News APIs (optional — GDELT is free and keyless)
# GNews: https://gnews.io/ (free tier: 100 req/day)
GNEWS_API_KEY=

# GitHub (optional — increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Demo Mode — set to true to use sample data everywhere
# Automatically enabled if critical APIs are unreachable
DEMO_MODE=false

# API URLs (defaults are built-in, override if needed)
REST_COUNTRIES_URL=https://restcountries.com/v3.1
WORLD_BANK_URL=https://api.worldbank.org/v2
GDELT_URL=https://api.gdeltproject.org/api/v2/doc/doc
CROSSREF_URL=https://api.crossref.org
